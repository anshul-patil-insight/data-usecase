-- Customers: "current state wins" by updated_at (business rule 1), not by
-- which file it arrived in. Day 0 delivers every customer; later days only
-- deliver new sign-ups / changed records, so we always rank across *all*
-- rows seen up to this run's date and keep the one with the max updated_at.
config {
  type: "view",
  description: "One row per customer_id: the version with the latest updated_at, as of ${dataform.projectConfig.vars.run_date}.",
}

with typed as (
  select
    customer_id,
    trim(name) as name,
    lower(trim(email)) as email,
    trim(phone) as phone,
    trim(city) as city,
    safe_cast(signup_date as date) as signup_date,
    safe_cast(updated_at as timestamp) as updated_at,
    _source_date,
    _loaded_at
  from ${ref("customers")}
  where _source_date <= date('${dataform.projectConfig.vars.run_date}')
    and customer_id is not null
),

ranked as (
  select
    *,
    row_number() over (
      partition by customer_id
      -- updated_at is the source of truth for "latest"; _loaded_at only
      -- breaks ties when two rows carry an identical/missing updated_at.
      order by updated_at desc nulls last, _loaded_at desc
    ) as rn
  from typed
)

select
  customer_id,
  name,
  email,
  phone,
  city,
  signup_date,
  updated_at,
  -- source_date of the WINNING (latest) version - lets core models cheaply
  -- filter to "customers whose current state changed today" for the
  -- incremental merge, without re-deriving latest-wins there too.
  _source_date
from ranked
where rn = 1
