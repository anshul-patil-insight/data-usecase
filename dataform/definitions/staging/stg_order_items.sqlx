-- Order items never change once placed, but can only safely be deduped by
-- (order_id, line_no) in case of an accidental re-export of the same file.
-- Invalid lines (quantity or unit_price <= 0, rule 5) are excluded here so
-- nothing downstream has to remember to filter them again.
config {
  type: "view",
  description: "One row per (order_id, line_no), invalid lines excluded, as of ${dataform.projectConfig.vars.run_date}.",
}

with typed as (
  select
    order_id,
    line_no,
    trim(item_name) as item_name,
    safe_cast(quantity as numeric) as quantity,
    safe_cast(unit_price as numeric) as unit_price,
    _source_date,
    _loaded_at
  from ${ref("order_items")}
  where _source_date <= date('${dataform.projectConfig.vars.run_date}')
    and order_id is not null
    and line_no is not null
),

ranked as (
  select
    *,
    row_number() over (
      partition by order_id, line_no
      order by _loaded_at desc
    ) as rn
  from typed
)

select
  order_id,
  line_no,
  item_name,
  quantity,
  unit_price,
  quantity * unit_price as line_amount,
  _source_date
from ranked
where rn = 1
  and quantity is not null and quantity > 0
  and unit_price is not null and unit_price > 0
